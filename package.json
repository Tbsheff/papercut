{
  "name": "papercut-cli",
  "version": "0.1.0",
  "description": "Agent-first local memory for development friction.",
  "type": "module",
  "bin": {
    "papercut": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build && git diff --exit-code -- dist && npm run pack:check",
    "dev": "tsx src/bin.ts",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tbsheff/papercut-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Tbsheff/papercut-cli/issues"
  },
  "homepage": "https://github.com/Tbsheff/papercut-cli#readme",
  "license": "MIT",
  "dependencies": {
    "incur": "^0.5.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
